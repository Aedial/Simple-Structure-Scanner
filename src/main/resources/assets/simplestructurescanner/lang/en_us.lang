# Config descriptions
config.structurescanner.client.enableSearch.desc=Enable or disable structure searching globally
config.structurescanner.client.i18nNames.desc=Use localized names instead of raw IDs in the UI
config.structurescanner.client.lastSelectedStructure.desc=Last selected structure ID (persisted between sessions)
config.structurescanner.client.filterText.desc=Last filter text (persisted between sessions)
config.structurescanner.client.showNonSearchable.desc=Remember whether non-searchable structures are shown in the structure list
config.structurescanner.client.showCurrentDimensionOnly.desc=Remember whether the structure list is limited to the current dimension only
config.structurescanner.client.searchedStructureIds.desc=List of structure IDs currently being searched
config.structurescanner.client.structureWhitelist.desc=Whitelist of structure IDs or partial matches allowed for searching. Takes priority over blacklist. Add ";radius" to make it local (e.g., "village;1000" only allows structures within 1000 blocks).
config.structurescanner.client.structureBlacklist.desc=Blacklist of structure IDs or partial matches to block from searching. Add ";radius" to make it local (e.g., "minecraft:;500" blocks vanilla structures beyond 500 blocks).
config.structurescanner.client.showBlocks.desc=Show blocks that are part of the structure in the details panel
config.structurescanner.client.showEntities.desc=Show entities that are part of the structure in the details panel
config.structurescanner.client.showLootTables.desc=Show loot tables that are part of the structure in the details panel
config.structurescanner.client.hudEnabled.desc=Enable or disable the HUD overlay showing searched structures
config.structurescanner.client.hudPaddingExternal.desc=Padding from screen edge for HUD overlay
config.structurescanner.client.hudPaddingInternal.desc=Padding inside the HUD box
config.structurescanner.client.hudLineSpacing.desc=Spacing between lines in HUD overlay
config.structurescanner.client.blacklistedLocations.desc=List of blacklisted structure locations in the format "world_id|structure_id|x|y|z". These locations will not be matched when searching.
config.structurescanner.server.enableSearch.desc=Enable or disable structure searching on the server (requires server-side installation)
config.structurescanner.title=Simple Structure Scanner Settings

